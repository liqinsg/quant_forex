# =========================================================================
# run.env — Scheduled Runner v1.4.5
# =========================================================================
# 优先级: CLI 参数 > 本文件 > 代码内硬编码默认值
# 注意: 仅当启动时携带 --live 时, 本文件中的新增参数才会生效;
#       未带 --live 时, 以下 MIN_GAP/MAX_ENTRIES/MC_NEUTRAL_TP/ALIGN_REQUIRED/
#       STRICT_ALIGN/GAP_THRESHOLD 均被忽略以保持向后兼容.
# =========================================================================

# -------------------------------------------------------------------------
# 1) 交易手数 (沿用既有逻辑, 无论是否 --live 都生效)
# -------------------------------------------------------------------------
LIVE_LOT_SIZE=1
DEMO_LOT_SIZE=10000
# Crypto lots
LIVE_LOT_SIZE_CRYPTO=0.01
DEMO_LOT_SIZE_CRYPTO=1
# 交易品种模式: forex(仅外汇) | crypto(仅加密) | forex-crypto(两者同时)
# 优先级: CLI --forex/-f 或 --crypto/-c 或 --forex-crypto/-b > 本项 > 代码默认 forex
TRADE_MODE=forex
# -------------------------------------------------------------------------
# 2) 全局 dry-run 开关  (已被 fx_trade_bot_v683.py 的 EXECUTION GATE 读取)
#    优先级: CLI --dry-run / --no-dry-run > 本项 > 代码默认 true
#    true  = 跑完整流程但不向 OANDA 发单（信号只打日志）
#    false = 真实发单（不带 --live 即在 demo 账户下单）
# -------------------------------------------------------------------------
DRY_RUN=false

# -------------------------------------------------------------------------
# 3) 入场筛选阈值 (仅 --live 有效)
# -------------------------------------------------------------------------
MIN_GAP=0.9314
GAP_THRESHOLD=1.5
STRICT_ALIGN=3.0
ALIGN_REQUIRED=3

# -------------------------------------------------------------------------
# 4) 多标的入场 & 止盈调整 (仅 --live 有效)
# -------------------------------------------------------------------------
MAX_ENTRIES=6
MC_NEUTRAL_TP=1.5
USE_MACD=true
# cross-group net exposure per base currency (BASE value).
# Recommended BASE=2 so the STRONG_MOMENTUM / STRONG_GAP boost rules
# (Part C/D) can differentiate regimes:  BASE=2 → NEUTRAL=2 /
# STRONG_MOMENTUM=3 / STRONG_GAP=4.  Setting BASE=3 collapses the first
# two regimes into a single identical value (differentiation lost).
CROSS_MAX_NET_PER_CCY=2
# Enable / disable JPY group execution (MAINTAIN risk gates + STRATEGY
# signal generation).  Default true.  CLI --trade-jpy false overrides.
# Set to false when a DIFFERENT account/runner owns the JPY book so this
# runner never touches JPY-owned trades.
TRADE_JPY=true

# -------------------------------------------------------------------------
# 5) Safety / guard rails
# -------------------------------------------------------------------------
# SL/TP guardian behaviour: True = repair drift (default, legacy);
# False = only repair MISSING SL/TP (let risk-engine trailing drift alone).
# GUARDIAN_REPAIR_DRIFT=false

# Account-guard: refuse to start unless the resolved account_id matches.
# Prevents cron-vs-interactive env drift selecting the wrong account.
# Set this to your live profile's account id when running --live.
EXPECT_ACCOUNT_ID_LIVE=001-003-21515688-001
EXPECT_ACCOUNT_ID=101-003-39389016-005

# ------------------------------------------------------------------------- 
# 6) 数据边界保护 (data_guard.py)
#    K 线数据不足时优雅跳过，避免 .iloc 越界崩溃
#    (single positional indexer is out-of-bounds / insufficient bars)
#    优先级: 环境变量 > data_guard 默认 200
# ------------------------------------------------------------------------- 
MIN_REQUIRED_BARS=200
OANDA_ENV=practice
# 交易阈值 (信号概率)
PROB_LONG_THRESHOLD=0.52 # 默认 0.65
PROB_SHORT_THRESHOLD=0.45 # 默认 0.35
# 加密独立信号概率阈值 (留空/删除则自动沿用上面的外汇值)
CRYPTO_PROB_LONG_THRESHOLD=0.50  # 默认 0.65
CRYPTO_PROB_SHORT_THRESHOLD=0.45  # 默认 0.35
# ATR 止损/止盈倍率 (外汇)
STOP_LOSS_ATR_MULTIPLIER=1.5
TAKE_PROFIT_ATR_MULTIPLIER=1.8
# 加密独立 ATR 止损/止盈倍率 (加密波动更高，故加宽)
CRYPTO_ATR_SL_MULTIPLIER=2.0
CRYPTO_ATR_TP_MULTIPLIER=2.5
# 加密独立年化波动率阈值 (外汇为 config.yaml 的 risk.vol_threshold_annual=0.15)
# 优先级: 本项 > config.yaml 的 crypto.vol_threshold_annual > 默认 1.0
CRYPTO_VOL_THRESHOLD=1.0
#TRADE_MODE=crypto   # forex / crypto / forex-crypto
TRADE_MODE=forex-crypto
# -------------------------------------------------------------------------
# 7) 分组控仓 (每次每组只开信号最强的 1 个)
#    OVERRIDE_MAX_OPEN=1 → 按分组独立控仓; =0 → 沿用全局 MAX_OPEN (0=不限)
#    优先级: 环境变量 > config.yaml 的 risk.* > 默认值
# -------------------------------------------------------------------------
OVERRIDE_MAX_OPEN=1
MAX_OPEN_PER_GROUP_FOREX=6    # 外汇组最多同时持仓
MAX_OPEN_PER_GROUP_CRYPTO=2   # 加密组最多同时持仓

# -------------------------------------------------------------------------
# 8) 关联组风控 (correlation check)
#    优先级: 环境变量 > config.yaml 的 risk.* > 默认值
# -------------------------------------------------------------------------
CORRELATION_CHECK_ENABLED=true
CORRELATION_JPY_STRICT=true
